# ============================================================================
# Printzy — Environment Configuration Template
# ============================================================================
# Copy this file to .env, .env.development, .env.staging, or .env.production
# based on your target environment.
#
# NOTE: Variables prefixed with VITE_* are public and baked into client-side
# JavaScript bundles at build time. Never store private secrets (such as database
# credentials or Turnstile secret keys) in VITE_* variables.

# ----------------------------------------------------------------------------
# 1. Environment Tier ('development' | 'staging' | 'production')
# ----------------------------------------------------------------------------
VITE_APP_ENV=development

# ----------------------------------------------------------------------------
# 2. Canonical Site URL
# - Development: http://localhost:3000
# - Staging:     https://staging.printzy.site
# - Production:  https://printzy.site
# ----------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 3. Sentry Error Telemetry (Optional for local dev, recommended for prod/staging)
# ----------------------------------------------------------------------------
# VITE_SENTRY_DSN=https://your-public-key@o000000.ingest.sentry.io/0000000

# ----------------------------------------------------------------------------
# 4. Cloudflare Turnstile Captcha
# - Demo always-passing key (Dev/Staging/Test): 1x00000000000000000000AA
# - Production: Your real site key from Cloudflare Dashboard
# ----------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ----------------------------------------------------------------------------
# 5. Product Analytics (true | false)
# - Dev:   false (or true for testing)
# - Stage: true
# - Prod:  true
# ----------------------------------------------------------------------------
VITE_ANALYTICS_ENABLED=false

# ----------------------------------------------------------------------------
# 6. Google Tag Manager Container ID
# - Leave blank in development to skip GTM loading
# - Prod/Staging: GTM-W8JX29CJ
# ----------------------------------------------------------------------------
VITE_GTM_ID=GTM-W8JX29CJ

# ============================================================================
# RUNTIME WORKER SECRETS (DO NOT SET AS VITE_* BUILD VARS!)
# ============================================================================
# For Local Dev: Store in .env.local (which is git-ignored)
# For Cloudflare Production/Staging: Set via Cloudflare Dashboard under:
#   Workers & Pages > printzy > Settings > Variables and Secrets
# Or via CLI:
#   npx wrangler secret put DATABASE_URL_POOLED
#   npx wrangler secret put TURNSTILE_SECRET_KEY
# ----------------------------------------------------------------------------

# Neon Lakebase Postgres Pooled Connection URL (strictly prioritized by server)
# Format: postgresql://[user]:[password]@[ep-xyz-pooler].[region].neon.tech/[dbname]?sslmode=require
DATABASE_URL_POOLED=postgresql://your_db_user:your_db_password@your-pooler-host.neon.tech/neondb?sslmode=require

# Direct Connection URL (optional fallback)
# DATABASE_URL=postgresql://your_db_user:your_db_password@your-direct-host.neon.tech/neondb?sslmode=require

# Cloudflare Turnstile Secret Key (server-side verification)
# Dev: 1x0000000000000000000000000000000AA (always passes)
# Prod: Your secret key from Cloudflare Turnstile Dashboard
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend transactional quote email secrets (server-side only; never use VITE_ prefix)
RESEND_API_KEY=re_your_resend_api_key
RESEND_TEMPLATE_ID=your_published_template_id
