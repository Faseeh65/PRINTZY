{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printzy",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_GENERAL",
      "namespace_id": "76349281001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_SENSITIVE",
      "namespace_id": "76349281002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
}
